{
  "name": "er-salary-pipeline",
  "type": "module",
  "private": true,
  "scripts": {
    "fetch": "node fetch-fb-salary.mjs",
    "fetch:dry": "node fetch-fb-salary.mjs --dry-run",
    "cookies": "node fetch-fb-salary.mjs --export-cookies",
    "test": "npm run test:js && npm run test:py",
